; Nusantara: Jejak Budaya -- Godot 4.3 project
; 2D top-down open-world Indonesian cultural adventure.
;
; The project is data driven: content lives in res://data/*.json and is loaded
; at runtime by the DataManager autoload.  Systems are split into autoload
; managers so that content can be extended without touching the engine code.

config_version=5

[application]

config/name="Nusantara: Jejak Budaya"
config/description="A 2D open-world adventure through the cultures of Indonesia."
config/version="1.0.0"
run/main_scene="res://scenes/main/game.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/ui/icon.png"
boot_splash/bg_color=Color(0.16, 0.12, 0.17, 1)
boot_splash/show_image=false

[autoload]

Data="*res://scripts/core/data_manager.gd"
Settings="*res://scripts/core/settings_manager.gd"
Audio="*res://scripts/core/audio_manager.gd"
Notify="*res://scripts/core/notify_manager.gd"
Game="*res://scripts/core/game_manager.gd"
Save="*res://scripts/core/save_manager.gd"
Items="*res://scripts/core/inventory_manager.gd"
Culture="*res://scripts/core/culture_manager.gd"
Quest="*res://scripts/core/quest_manager.gd"
Achievements="*res://scripts/core/achievement_manager.gd"
Dialogue="*res://scripts/core/dialogue_manager.gd"
Puzzle="*res://scripts/core/puzzle_manager.gd"
World="*res://scripts/core/world_manager.gd"
UI="*res://scripts/ui/ui_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[internationalization]

locale="en"

[input]

